 import heapq
def astar(graph, start, goal, h):
    open_list = [(0, start)]
    g = {start: 0}
    while open_list:
        _, node = heapq.heappop(open_list)
        if node == goal:
            return g[node]
        for neighbor, cost in graph[node]:
            temp = g[node] + cost
            if neighbor not in g or temp < g[neighbor]:
                g[neighbor] = temp
                heapq.heappush(open_list, (temp + h[neighbor], neighbor))
graph = {
    'A': [('B',1),('C',3)],
    'B': [('D',1)],
    'C': [('D',1)],
    'D': []
}
heuristic = {'A':3,'B':1,'C':1,'D':0}
print(astar(graph,'A','D',heuristic))
