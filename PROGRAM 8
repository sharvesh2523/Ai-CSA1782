from itertools import permutations
graph = {
    'A': {'B':10,'C':15,'D':20},
    'B': {'A':10,'C':35,'D':25},
    'C': {'A':15,'B':35,'D':30},
    'D': {'A':20,'B':25,'C':30}
}
def tsp(start):
    cities = list(graph.keys())
    cities.remove(start)
    min_path = float('inf')
    for perm in permutations(cities):
        cost = 0
        k = start
        for city in perm:
            cost += graph[k][city]
            k = city
        cost += graph[k][start]
        min_path = min(min_path, cost)
    print("Minimum cost:", min_path)
tsp('A')
