def ab(b,a,beta,maxp):
    win=[(0,1,2),(3,4,5),(6,7,8),(0,3,6),(1,4,7),(2,5,8),(0,4,8),(2,4,6)]
    for x,y,z in win:
        if b[x]==b[y]==b[z]!=' ': return 1 if b[x]=='O' else -1
    if ' ' not in b: return 0
    
    if maxp:
        v=-2
        for i in range(9):
            if b[i]==' ':
                b[i]='O'
                v=max(v,ab(b,a,beta,0))
                b[i]=' '
                a=max(a,v)
                if a>=beta: break
        return v
    else:
        v=2
        for i in range(9):
            if b[i]==' ':
                b[i]='X'
                v=min(v,ab(b,a,beta,1))
                b[i]=' '
                beta=min(beta,v)
                if beta<=a: break
        return v
