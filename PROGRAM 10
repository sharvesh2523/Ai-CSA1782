states = ['A','B','C']
adj = {'A':['B','C'],'B':['A','C'],'C':['A','B']}
colors = ['R','G','B']

def solve(a={}):
    if len(a)==3: return a
    s=[x for x in states if x not in a][0]
    for c in colors:
        if all(a.get(n)!=c for n in adj[s]):
            a[s]=c
            r=solve(a)
            if r: return r
            del a[s]

print(solve())
